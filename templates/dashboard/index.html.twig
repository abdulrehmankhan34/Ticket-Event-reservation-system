{% extends 'base.html.twig' %}

{% block title %}Dashboard{% endblock %}

{% block body %}
    <h1>Dashboard</h1>

    <p>
        Logged in as <strong>{{ user.email }}</strong>.
    </p>

    <ul>
        <li>Credits: <strong>{{ user.creditBalance }}</strong></li>
        <li>Timezone: <strong>{{ user.timezone }}</strong></li>
        <li>Roles: <strong>{{ user.roles|join(', ') }}</strong></li>
    </ul>
{% endblock %}

