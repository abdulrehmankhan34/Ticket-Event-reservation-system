{% extends 'base.html.twig' %}

{% block title %}Admin Dashboard{% endblock %}

{% block body %}
    <h1>Admin dashboard</h1>

    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert {{ label == 'success' ? 'alert-success' : (label in ['error','danger'] ? 'alert-error' : 'alert-info') }}">
                {{ message }}
            </div>
        {% endfor %}
    {% endfor %}

    <section class="kpi-grid" style="margin-top: 12px;">
        <div class="card">
            <div class="kpi-title">Total users</div>
            <div class="kpi-value">{{ users }}</div>
        </div>
        <div class="card">
            <div class="kpi-title">Total events</div>
            <div class="kpi-value">{{ events }}</div>
        </div>
        <div class="card">
            <div class="kpi-title">Tickets sold</div>
            <div class="kpi-value">{{ ticketsSold }}</div>
        </div>
        <div class="card">
            <div class="kpi-title">System revenue (1%)</div>
            <div class="kpi-value">{{ systemRevenue }}</div>
        </div>
    </section>

    <div style="display:flex; align-items:flex-end; justify-content:space-between; gap:12px; flex-wrap:wrap; margin-top: 18px;">
        <h2 style="margin:0;">Events (recent)</h2>
        <div class="actions">
            <a class="btn btn-ghost" href="{{ path('app_admin_organizers_index') }}">Manage organizers</a>
        </div>
    </div>
    {% if recentEvents is empty %}
        <p>No events yet.</p>
    {% else %}
        <table class="table" style="margin-top:10px;">
            <thead>
            <tr>
                <th>Name</th>
                <th>Status</th>
                <th>Starts</th>
                <th>Actions</th>
            </tr>
            </thead>
            <tbody>
            {% for e in recentEvents %}
                <tr>
                    <td style="font-weight:650;">
                        <a class="subtle-link" href="{{ path('app_events_show', {id: e.id}) }}">{{ e.name }}</a>
                    </td>
                    <td>
                        <span class="pill">
                            <span class="dot {{ e.status == 'cancelled' ? '' : 'ok' }}"></span>
                            {{ e.status }}
                        </span>
                    </td>
                    <td style="color:#374151;">{{ e.startsAt|date('Y-m-d H:i') }}</td>
                    <td>
                        {% if e.status != 'cancelled' %}
                            <form method="post" action="{{ path('app_admin_event_cancel', {id: e.id}) }}" class="actions">
                                <input type="hidden" name="_token" value="{{ csrf_token('cancel_event_' ~ e.id) }}">
                                <button class="btn btn-danger" type="submit" onclick="return confirm('Cancel this event and refund all ticket holders?')">Cancel + refund</button>
                            </form>
                        {% else %}
                            —
                        {% endif %}
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    {% endif %}

    <div class="alert alert-info" style="margin-top:12px;">
        Organizer approvals are available in <a class="subtle-link" href="{{ path('app_admin_organizers_index') }}">Manage organizers</a>.
    </div>
{% endblock %}

