{% extends 'base.html.twig' %}

{% block title %}Admin Dashboard{% endblock %}

{% block body %}
    <h1>Admin dashboard</h1>

    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div style="padding:10px; margin:8px 0; border:1px solid #ddd;">
                <strong>{{ label }}:</strong> {{ message }}
            </div>
        {% endfor %}
    {% endfor %}

    <div style="display:grid; grid-template-columns: repeat(4, 1fr); gap:12px; margin-top: 12px;">
        <div style="border:1px solid #eee; padding:12px; border-radius:8px;">
            <div style="color:#555;">Total users</div>
            <div style="font-size: 22px;"><strong>{{ users }}</strong></div>
        </div>
        <div style="border:1px solid #eee; padding:12px; border-radius:8px;">
            <div style="color:#555;">Total events</div>
            <div style="font-size: 22px;"><strong>{{ events }}</strong></div>
        </div>
        <div style="border:1px solid #eee; padding:12px; border-radius:8px;">
            <div style="color:#555;">Tickets sold</div>
            <div style="font-size: 22px;"><strong>{{ ticketsSold }}</strong></div>
        </div>
        <div style="border:1px solid #eee; padding:12px; border-radius:8px;">
            <div style="color:#555;">System revenue (1%)</div>
            <div style="font-size: 22px;"><strong>{{ systemRevenue }}</strong></div>
        </div>
    </div>

    <h2 style="margin-top: 18px;">Events (recent)</h2>
    {% if recentEvents is empty %}
        <p>No events yet.</p>
    {% else %}
        <table style="width:100%; border-collapse: collapse;">
            <thead>
            <tr>
                <th style="text-align:left; border-bottom:1px solid #ddd; padding:8px;">Name</th>
                <th style="text-align:left; border-bottom:1px solid #ddd; padding:8px;">Status</th>
                <th style="text-align:left; border-bottom:1px solid #ddd; padding:8px;">Starts</th>
                <th style="text-align:left; border-bottom:1px solid #ddd; padding:8px;">Actions</th>
            </tr>
            </thead>
            <tbody>
            {% for e in recentEvents %}
                <tr>
                    <td style="padding:8px; border-bottom:1px solid #eee;">
                        <a href="{{ path('app_events_show', {id: e.id}) }}">{{ e.name }}</a>
                    </td>
                    <td style="padding:8px; border-bottom:1px solid #eee;">{{ e.status }}</td>
                    <td style="padding:8px; border-bottom:1px solid #eee;">{{ e.startsAt|date('Y-m-d H:i') }}</td>
                    <td style="padding:8px; border-bottom:1px solid #eee;">
                        {% if e.status != 'cancelled' %}
                            <form method="post" action="{{ path('app_admin_event_cancel', {id: e.id}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('cancel_event_' ~ e.id) }}">
                                <button type="submit" onclick="return confirm('Cancel this event and refund all ticket holders?')">
                                    Cancel + refund
                                </button>
                            </form>
                        {% else %}
                            —
                        {% endif %}
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    {% endif %}

    <p style="margin-top: 12px;">
        Organizer approvals: <a href="{{ path('app_admin_organizers_index') }}">Manage organizers</a>
    </p>
{% endblock %}

