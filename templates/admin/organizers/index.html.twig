{% extends 'base.html.twig' %}

{% block title %}Admin - Organizers{% endblock %}

{% block body %}
    <h1>Organizer Management</h1>

    <h2>Pending approvals ({{ pending|length }})</h2>
    {% if pending is empty %}
        <p>No pending organizer applications.</p>
    {% else %}
        <table class="table" style="margin-top:10px;">
            <thead>
                <tr>
                    <th>Email</th>
                    <th>Applied</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
            {% for p in pending %}
                <tr>
                    <td style="font-weight:650;">{{ p.user.email }}</td>
                    <td style="color:#374151;">{{ p.createdAt|date('Y-m-d H:i') }}</td>
                    <td>
                        <div class="actions">
                        <form method="post" action="{{ path('app_admin_organizers_approve', {id: p.id}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('approve_org_' ~ p.id) }}">
                            <button class="btn btn-primary" type="submit">Approve</button>
                        </form>
                        <form method="post" action="{{ path('app_admin_organizers_reject', {id: p.id}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('reject_org_' ~ p.id) }}">
                            <button class="btn btn-danger" type="submit">Reject</button>
                        </form>
                        </div>
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    {% endif %}

    <h2 style="margin-top:24px;">All organizers ({{ all|length }})</h2>
    {% if all is empty %}
        <p>No organizer profiles yet.</p>
    {% else %}
        <table class="table" style="margin-top:10px;">
            <thead>
            <tr>
                <th>Email</th>
                <th>Status</th>
                <th>Active</th>
                <th>Actions</th>
            </tr>
            </thead>
            <tbody>
            {% for p in all %}
                <tr>
                    <td style="font-weight:650;">{{ p.user.email }}</td>
                    <td>
                        <span class="pill">
                            <span class="dot {{ p.approvalStatus in ['approved','active'] ? 'ok' : 'primary' }}"></span>
                            {{ p.approvalStatus }}
                        </span>
                    </td>
                    <td>
                        <span class="pill">
                            <span class="dot {{ p.active ? 'ok' : '' }}"></span>
                            {{ p.active ? 'Active' : 'Inactive' }}
                        </span>
                    </td>
                    <td>
                        <form method="post" action="{{ path('app_admin_organizers_toggle_active', {id: p.id}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('toggle_org_' ~ p.id) }}">
                            <button class="btn {{ p.active ? 'btn-danger' : 'btn-primary' }}" type="submit">{{ p.active ? 'Deactivate' : 'Reactivate' }}</button>
                        </form>
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    {% endif %}
{% endblock %}

