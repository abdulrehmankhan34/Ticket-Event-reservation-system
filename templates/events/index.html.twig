{% extends 'base.html.twig' %}

{% block title %}Events{% endblock %}

{% block body %}
    <h1 style="margin-bottom:16px;">Upcoming events</h1>

   <form method="get" action="{{ path('app_events_index') }}" 
      style="display:grid; gap:16px; padding:18px; border:1px solid #e5e7eb; border-radius:14px; background:#fafafa; width:100%; max-width:1100px;">

    <div style="display:grid; gap:14px; grid-template-columns: 2fr 1fr 1fr 1fr;">
        <label style="display:flex; flex-direction:column; gap:6px;">
            Search
            <input name="q" value="{{ filters.q }}" placeholder="Event name..." 
                   style="width:100%; padding:10px; border:1px solid #ddd; border-radius:8px;">
        </label>

        <label style="display:flex; flex-direction:column; gap:6px;">
            Category
            <input name="category" value="{{ filters.category }}" placeholder="Concert, Sports..." 
                   style="width:100%; padding:10px; border:1px solid #ddd; border-radius:8px;">
        </label>

        <label style="display:flex; flex-direction:column; gap:6px;">
            From
            <input type="datetime-local" name="date_from" value="{{ filters.date_from }}" 
                   style="width:100%; padding:10px; border:1px solid #ddd; border-radius:8px;">
        </label>

        <label style="display:flex; flex-direction:column; gap:6px;">
            To
            <input type="datetime-local" name="date_to" value="{{ filters.date_to }}" 
                   style="width:100%; padding:10px; border:1px solid #ddd; border-radius:8px;">
        </label>
    </div>

    <div style="display:flex; gap:14px; align-items:center; flex-wrap:wrap;">
        <label style="display:flex; flex-direction:column; gap:6px;">
            Online
            <select name="online" style="padding:10px; border:1px solid #ddd; border-radius:8px;">
                <option value="" {{ filters.online == '' ? 'selected' : '' }}>Any</option>
                <option value="1" {{ filters.online == '1' ? 'selected' : '' }}>Online</option>
                <option value="0" {{ filters.online == '0' ? 'selected' : '' }}>Physical</option>
            </select>
        </label>

        <button type="submit" 
                style="margin-top:20px; padding:10px 18px; border:none; border-radius:8px; background:#2563eb; color:white; cursor:pointer;">
            Apply filters
        </button>

        <a href="{{ path('app_events_index') }}" 
           style="margin-top:20px; padding:9px 14px; border-radius:8px; border:1px solid #ddd; text-decoration:none; color:#333;">
            Reset
        </a>
    </div>
</form>

    {% if events is empty %}
        <p style="margin-top: 16px;">No upcoming events yet.</p>
    {% else %}
        <div style="margin-top: 20px; display:grid; gap:14px;">
            {% for e in events %}
                <div style="padding:14px; border:1px solid #e5e7eb; border-radius:12px; background:white;">
                    <h2 style="margin:0 0 8px 0;">
                        <a href="{{ path('app_events_show', {id: e.id}) }}" style="text-decoration:none; color:#111;">
                            {{ e.name }}
                        </a>
                    </h2>

                    <div style="color:#555; font-size:14px; line-height:1.5;">
                        <div><strong>When:</strong> {{ e.startsAt|date('Y-m-d H:i') }} ({{ e.timezone }})</div>
                        <div><strong>Category:</strong> {{ e.category }}</div>
                        <div>
                            <strong>Venue:</strong>
                            {% if e.online %}
                                Online
                            {% else %}
                                {{ e.venueName ?: 'TBA' }}
                            {% endif %}
                        </div>
                    </div>

                    {% set tierList = tiersByEvent[e.id] ?? [] %}
                    {% if tierList is not empty %}
                        <div style="margin-top: 12px;">
                            <strong>Ticket tiers:</strong>
                            <ul style="margin: 6px 0 0 18px;">
                                {% for t in tierList %}
                                    {% set remaining = remainingByTierId[t.id] ?? t.totalSeats %}
                                    <li style="margin-bottom:4px;">
                                        {{ t.name }} — {{ t.basePrice }} credits (base)
                                        — <strong style="color:#16a34a;">{{ remaining }}</strong> left
                                    </li>
                                {% endfor %}
                            </ul>
                        </div>
                    {% else %}
                        <div style="margin-top:10px; color:#777;">No tiers defined yet.</div>
                    {% endif %}
                </div>
            {% endfor %}
        </div>
    {% endif %}
{% endblock %}