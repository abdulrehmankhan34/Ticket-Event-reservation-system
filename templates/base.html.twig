<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Welcome!{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">
        {% block stylesheets %}
            <style>
                :root{
                    --bg: #ffffff;
                    --fg: #111827;
                    --muted: #6b7280;
                    --border: #e5e7eb;
                    --soft: #f3f4f6;
                    --primary: #2563eb;
                    --primaryHover: #1d4ed8;
                    --danger: #ef4444;
                }

                body{
                    margin: 0;
                    font-family: ui-sans-serif, system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial, "Apple Color Emoji", "Segoe UI Emoji";
                    color: var(--fg);
                    background: #fafafa;
                }

                h1{ font-size: 24px; margin: 0 0 14px; letter-spacing: -0.01em; }
                h2{ font-size: 16px; margin: 18px 0 10px; color: #111827; }

                .card{
                    background: var(--bg);
                    border: 1px solid var(--border);
                    border-radius: 14px;
                    padding: 16px;
                    box-shadow: 0 1px 10px rgba(0,0,0,.04);
                }

                .meta-grid{
                    display: grid;
                    grid-template-columns: repeat(2, minmax(0, 1fr));
                    gap: 10px 14px;
                    color: #374151;
                    font-size: 14px;
                }
                .meta-grid strong{ color: #111827; font-weight: 650; }
                @media (max-width: 640px){
                    .meta-grid{ grid-template-columns: 1fr; }
                }

                .table{
                    width: 100%;
                    border-collapse: separate;
                    border-spacing: 0;
                    overflow: hidden;
                    border: 1px solid var(--border);
                    border-radius: 14px;
                    background: var(--bg);
                }
                .table th{
                    text-align: left;
                    font-size: 12px;
                    letter-spacing: .02em;
                    text-transform: uppercase;
                    color: var(--muted);
                    background: #fafafa;
                    border-bottom: 1px solid var(--border);
                    padding: 12px 12px;
                    white-space: nowrap;
                }
                .table td{
                    padding: 12px 12px;
                    border-bottom: 1px solid var(--border);
                    vertical-align: middle;
                    font-size: 14px;
                }
                .table tbody tr:last-child td{ border-bottom: none; }

                .pill{
                    display: inline-flex;
                    align-items: center;
                    gap: 8px;
                    padding: 6px 10px;
                    border-radius: 999px;
                    font-size: 12px;
                    border: 1px solid var(--border);
                    background: var(--soft);
                    color: #111827;
                    white-space: nowrap;
                }
                .dot{
                    width: 8px;
                    height: 8px;
                    border-radius: 50%;
                    background: var(--muted);
                }
                .dot.primary{ background: var(--primary); }
                .dot.ok{ background: #16a34a; }

                .actions{
                    display: inline-flex;
                    align-items: center;
                    gap: 10px;
                    flex-wrap: wrap;
                }

                .btn{
                    appearance: none;
                    border: 1px solid var(--border);
                    background: var(--bg);
                    color: var(--fg);
                    border-radius: 10px;
                    padding: 8px 12px;
                    font-weight: 650;
                    font-size: 13px;
                    text-decoration: none;
                    display: inline-flex;
                    align-items: center;
                    gap: 8px;
                    transition: transform .06s ease, box-shadow .12s ease, background .12s ease, border-color .12s ease;
                    cursor: pointer;
                    line-height: 1;
                }
                .btn:hover{
                    background: #fbfbfb;
                    border-color: #d1d5db;
                    box-shadow: 0 6px 18px rgba(0,0,0,.06);
                    transform: translateY(-1px);
                }
                .btn:active{
                    transform: translateY(0px);
                    box-shadow: 0 4px 14px rgba(0,0,0,.06);
                }
                .btn-primary{
                    background: var(--primary);
                    border-color: var(--primary);
                    color: white;
                }
                .btn-primary:hover{
                    background: var(--primaryHover);
                    border-color: var(--primaryHover);
                }
                .btn-ghost{
                    background: transparent;
                }
                .btn-danger{
                    background: var(--danger);
                    border-color: var(--danger);
                    color: white;
                }
                .btn-danger:hover{
                    filter: brightness(.95);
                    border-color: #dc2626;
                }

                .spinner{
                    width: 14px;
                    height: 14px;
                    border-radius: 999px;
                    border: 2px solid #e5e7eb;
                    border-top-color: var(--primary);
                    animation: spin 900ms linear infinite;
                }
                @keyframes spin{ to{ transform: rotate(360deg); } }

                .alert{
                    border: 1px solid var(--border);
                    border-radius: 14px;
                    padding: 12px 14px;
                    background: var(--bg);
                    box-shadow: 0 1px 10px rgba(0,0,0,.04);
                    font-size: 14px;
                    color: #111827;
                }
                .alert + .alert{ margin-top: 10px; }
                .alert-success{
                    border-color: rgba(22,163,74,.25);
                    background: rgba(22,163,74,.08);
                }
                .alert-error{
                    border-color: rgba(239,68,68,.25);
                    background: rgba(239,68,68,.08);
                }
                .alert-info{
                    border-color: rgba(37,99,235,.25);
                    background: rgba(37,99,235,.06);
                }

                .kpi-grid{
                    display: grid;
                    grid-template-columns: repeat(4, minmax(0, 1fr));
                    gap: 12px;
                }
                @media (max-width: 980px){
                    .kpi-grid{ grid-template-columns: repeat(2, minmax(0, 1fr)); }
                }
                @media (max-width: 520px){
                    .kpi-grid{ grid-template-columns: 1fr; }
                }
                .kpi-title{
                    color: var(--muted);
                    font-size: 12px;
                    letter-spacing: .02em;
                    text-transform: uppercase;
                    margin-bottom: 8px;
                }
                .kpi-value{
                    font-size: 26px;
                    font-weight: 800;
                    letter-spacing: -0.02em;
                }
                .subtle-link{
                    color: var(--primary);
                    text-decoration: none;
                    font-weight: 650;
                }
                .subtle-link:hover{ text-decoration: underline; }
            </style>
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}

        {% set frankenphpHotReload = app.request.server.get('FRANKENPHP_HOT_RELOAD') %}
        {% if frankenphpHotReload %}
        <meta name="frankenphp-hot-reload:url" content="{{ frankenphpHotReload }}">
        <script src="https://cdn.jsdelivr.net/npm/idiomorph"></script>
        <script src="https://cdn.jsdelivr.net/npm/frankenphp-hot-reload/+esm" type="module"></script>
        {% endif %}
    </head>
   <body>
    {% set current = app.request.attributes.get('_route') %}
    <nav style="
        position: sticky;
        top: 0;
        z-index: 50;
        padding: 12px 16px;
        border-bottom: 1px solid #e5e7eb;
        display:flex;
        align-items:center;
        gap:10px;
        flex-wrap:wrap;
        background: rgba(255,255,255,.92);
        backdrop-filter: blur(8px);
        box-shadow: 0 1px 10px rgba(0,0,0,.04);
    ">
        <a href="{{ path('app_events_index') }}" style="
            text-decoration:none;
            font-weight:700;
            color:#111827;
            padding:8px 10px;
            border-radius:10px;
            {{ current == 'app_events_index' ? 'background:#f3f4f6;' : '' }}
        ">
            Events
        </a>

        {% if app.user %}
            <a href="{{ path('app_cart_show') }}" style="
                text-decoration:none;
                padding:8px 10px;
                border-radius:10px;
                color:#111827;
                {{ current starts with 'app_cart' ? 'background:#f3f4f6;' : '' }}
            ">
                Cart
            </a>
        {% endif %}

        <a href="{{ path('app_dashboard') }}" style="
            text-decoration:none;
            padding:8px 10px;
            border-radius:10px;
            color:#111827;
            {{ current starts with 'app_dashboard' ? 'background:#f3f4f6;' : '' }}
        ">
            Dashboard
        </a>

        {% if app.user %}
            {% if not is_granted('ROLE_ADMIN') %}
                <a href="{{ path('app_organizer_dashboard') }}" style="
                    text-decoration:none;
                    padding:8px 10px;
                    border-radius:10px;
                    color:#111827;
                    {{ current starts with 'app_organizer' ? 'background:#f3f4f6;' : '' }}
                ">
                    Organizer
                </a>
            {% endif %}

            {% if is_granted('ROLE_ADMIN') %}
                <a href="{{ path('app_admin_dashboard') }}" style="
                    text-decoration:none;
                    padding:8px 10px;
                    border-radius:10px;
                    color:#111827;
                    {{ current starts with 'app_admin' ? 'background:#f3f4f6;' : '' }}
                ">
                    Admin
                </a>
            {% endif %}
        {% endif %}

        <div style="margin-left:auto; display:flex; align-items:center; gap:10px; flex-wrap:wrap;">
            {% if app.user %}
                <span style="
                    padding:6px 10px;
                    background:#f3f4f6;
                    border-radius:999px;
                    font-size:13px;
                    color:#111827;
                ">
                    {{ app.user.userIdentifier }} · <strong>{{ app.user.creditBalance }}</strong> credits
                </span>

                <a href="{{ path('app_logout') }}" style="
                    text-decoration:none;
                    padding:8px 12px;
                    border-radius:10px;
                    background:#ef4444;
                    color:white;
                    font-weight:600;
                ">
                    Logout
                </a>
            {% else %}
                <a href="{{ path('app_login') }}" style="
                    text-decoration:none;
                    padding:8px 12px;
                    border-radius:10px;
                    border:1px solid #e5e7eb;
                    color:#111827;
                    font-weight:600;
                    background:#ffffff;
                ">
                    Login
                </a>

                <a href="{{ path('app_register') }}" style="
                    text-decoration:none;
                    padding:8px 12px;
                    border-radius:10px;
                    background:#2563eb;
                    color:white;
                    font-weight:600;
                ">
                    Register
                </a>
            {% endif %}
        </div>
    </nav>

    <main style="max-width: 1100px; margin: 28px auto; padding: 0 16px;">
        {% block body %}{% endblock %}
    </main>
</body>
</html>
