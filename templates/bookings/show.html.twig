{% extends 'base.html.twig' %}

{% block title %}Booking {{ booking.id }}{% endblock %}

{% block body %}
    <h1>Booking confirmation</h1>

    <section class="card" style="margin-bottom:16px;">
        <div class="meta-grid">
            <div><strong>Booking ID</strong><div style="margin-top:4px; color:#374151;">#{{ booking.id }}</div></div>
            <div>
                <strong>Status</strong>
                <div style="margin-top:6px;">
                    <span class="pill">
                        <span class="dot {{ booking.status in ['paid','confirmed','complete','completed'] ? 'ok' : 'primary' }}"></span>
                        {{ booking.status }}
                    </span>
                </div>
            </div>
            <div><strong>Total credits</strong><div style="margin-top:4px; color:#374151;">{{ booking.totalCredits }}</div></div>
            <div><strong>Event</strong><div style="margin-top:4px; color:#374151;">{{ booking.event.name }}</div></div>
            <div><strong>Created</strong><div style="margin-top:4px; color:#374151;">{{ booking.createdAt|date('Y-m-d H:i') }}</div></div>
        </div>
    </section>

    <h2>Items</h2>
    {% if items is empty %}
        <p>No items.</p>
    {% else %}
        <table class="table">
            <thead>
            <tr>
                <th>Tier</th>
                <th>Qty</th>
                <th>Unit base</th>
                <th>Unit final</th>
                <th>Fee</th>
                <th>E‑Ticket</th>
            </tr>
            </thead>
            <tbody>
            {% for bi in items %}
                <tr>
                    <td>{{ bi.tier.name }}</td>
                    <td>{{ bi.quantity }}</td>
                    <td>{{ bi.unitBasePrice }}</td>
                    <td>{{ bi.unitFinalPrice }}</td>
                    <td>{{ bi.systemFee }}</td>
                    <td>
                        {% if ticketByItemId[bi.id] is defined %}
                            <div class="actions">
                                <a class="btn btn-primary" href="{{ path('app_eticket_download', {id: bi.id}) }}">Download PDF</a>
                            </div>
                        {% else %}
                            <div class="actions">
                                <span class="pill" title="E-ticket is being generated">
                                    <span class="spinner" aria-hidden="true"></span>
                                    Generating
                                </span>
                                <a class="btn btn-ghost" href="{{ path('app_eticket_download', {id: bi.id}) }}">Check</a>
                            </div>
                        {% endif %}
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    {% endif %}
{% endblock %}

